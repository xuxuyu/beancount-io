# Dokploy deployment environment for beancount.io.
# Copy these values into Dokploy's Environment panel.
# Replace every change-me value before the first deployment.

APP_DOMAIN=beancount.4ree.com
API_DOMAIN=beancount-api.4ree.com
GIT_DOMAIN=beancount-git.4ree.com

AUTH_SECRET=change-me-auth-secret
COOKIE_SECRETS=["change-me-cookie-secret"]
ADMIN_TOKEN=change-me-admin-token
METRICS_API_TOKEN=change-me-metrics-token
AUTH_JWT_EXP_MINUTES=525600

# Personal bootstrap: replace the email, register once, then set
# SIGNUP_ENABLED=false and redeploy.
SIGNUP_ENABLED=true
SIGNUP_ALLOWED_EMAIL=your-login-email@example.com
SIGNUP_OTP_DELIVERY=log

FAVA_API_ADMIN_USER=beancount_admin
FAVA_API_ADMIN_PASSWORD=change-me-gitea-admin-password
GITEA_ADMIN_EMAIL=change-me@example.com

GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-database-password
GITEA_DB_NAME=gitea
BACKEND_DB_USER=beancount
BACKEND_DB_PASSWORD=change-me-backend-database-password
BACKEND_DB_NAME=beancount

GITEA_SECRET_KEY=change-me-gitea-secret-key
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
GITEA_LFS_JWT_SECRET=change-me-gitea-lfs-jwt-secret
GITEA_OAUTH2_JWT_SECRET=change-me-gitea-oauth2-jwt-secret

GITEA_IMAGE=docker.gitea.com/gitea:1.24
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
BEANCOUNT_IMAGE_TAG=selfhosted

BLOCKEDEN_ACCESS_KEY=local-dev-placeholder
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ASK_AI_MODE=bql
AGENT_MODE=self-hosted
CLAUDE_CODE_SANDBOX_URL=
CLAUDE_CODE_AGENT_URL=

SEND_GRID_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
TEMP_ASSETS_AWS_S3_ENDPOINT=
PERM_ASSETS_AWS_S3_REGION=us-east-1
PERM_ASSETS_AWS_S3_BUCKET=
PERM_ASSETS_AWS_S3_ACCESS_KEY_ID=
PERM_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
PERM_ASSETS_AWS_S3_ENDPOINT=
LOKI_HOST=
LOG_LEVEL=info

# Phase 1: keep SSH disabled until the Gitea host key has been extracted.
SSH_PORT=2222
SSH_PROXY_ENABLED=false
SSH_PROXY_HOST_KEY=
