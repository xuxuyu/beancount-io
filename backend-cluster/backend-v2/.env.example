# Core services
POSTGRES_BACKEND_URI=postgresql://user:password@localhost:5432/beancount
REDIS_URI=redis://localhost:6379
FAVA_API_URL=http://localhost:8000
FAVA_API_ADMIN_USER=admin
FAVA_API_ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me
AUTH_COOKIE_DOMAIN=
SELF_HOSTED_TIER=

# Optional OpenAI or OpenAI-compatible LLM provider. Include the API version
# path (usually /v1) in OPENAI_BASE_URL. API mode: responses or chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_API_MODE=responses

# Public deployment configuration. Production OAuth uses DASHBOARD_URL as its
# issuer/front door; the local stack uses SERVER_URL for its direct backend.
# These are configuration, not secrets.
SERVER_URL=http://localhost:4104
DASHBOARD_URL=http://localhost:5173

# OAuth authorization-server signing keys. Production must receive a complete
# private P-256/ES256 JWKS as a deployment secret. Never commit a real value.
# Development and test generate an ephemeral process-local key. Without this
# secret in production, OAuth returns 503 but legacy login and the API stay up.
OAUTH_JWKS=
